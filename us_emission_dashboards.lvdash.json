      ],
      "catalog": "us_emissions_catalog_8_5",
      "schema": "raw"
    },
    {
      "name": "eaef2420",
      "displayName": "emission_map",
      "queryLines": [
        "SELECT\r\n",
        "  county_name,\r\n",
        "  state_abbr,\r\n",
        "  lati,\r\n",
        "  long,\r\n",
        "  population,\r\n",
        "  ghg_emissions_mtco2e,\r\n",
        "  ROUND(ghg_emissions_mtco2e / population * 1000, 4) AS emission_per1000_capita\r\n",
        "FROM emission_df2\r\n",
        "ORDER BY ghg_emissions_mtco2e DESC;"
      ],
      "catalog": "us_emissions_catalog_8_5",
      "schema": "raw"
    },
    {
      "name": "2555e13a",
      "displayName": "emission_per_person_counties",
      "queryLines": [
        "SELECT \r\n",
        "  county_state_label,\r\n",
        "  ghg_emissions_mtco2e,\r\n",
        "  population,\r\n",
        "  ROUND(ghg_emissions_mtco2e/population, 4) AS emission_per_person_ct\r\n",
        "FROM emission_df2\r\n",
        "ORDER BY emission_per_person_ct DESC\r\n",
        "LIMIT 20;"
      ],
      "catalog": "us_emissions_catalog_8_5",
      "schema": "raw"
    },
    {
      "name": "3d63456e",
      "displayName": "State Greenhouse Gas Emissions Per Capita Rankings",
      "queryLines": [
        "WITH state_emisions AS (\r\n",
        "  SELECT \r\n",
        "    state_abbr,\r\n",
        "    SUM(ghg_emissions_mtco2e) AS total_st_emissions,\r\n",
        "    SUM(population) AS Total_st_population\r\n",
        "  FROM emission_df2\r\n",
        "  GROUP BY state_abbr\r\n",
        "  ORDER BY total_st_emissions DESC\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  total_st_emissions,\r\n",
        "  Total_st_population,\r\n",
        "  ROUND(total_st_emissions / (SELECT SUM(total_st_emissions) FROM state_emisions)* 1000, 3) AS pct_emission_state\r\n",
        "FROM state_emisions\r\n",
        "ORDER BY pct_emission_state DESC\r\n",
        "LIMIT 15;"
      ],
      "catalog": "us_emissions_catalog_8_5",
      "schema": "raw"
    },
    {
      "name": "c1c1e650",
      "displayName": "Top_state_emission",
      "queryLines": [
        "/* emission per states */\r\n",
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  ghg_emissions_mtco2e AS GAS_emission\r\n",
        "FROM emission_df2\r\n",
        "ORDER BY ghg_emissions_mtco2e DESC;"
      ],
      "catalog": "us_emissions_catalog_8_5",
      "schema": "raw"
    },
    {
      "name": "31159e24",
      "displayName": "totals_by_county",
      "queryLines": [
        "/* totals by county */\r\n",
        "SELECT \r\n",
        "  county_state_label,\r\n",
        "  SUM(population) AS Total_population,\r\n",
        "  SUM(ghg_emissions_mtco2e) AS Total_emissions\r\n",
        "FROM emission_df2\r\n",
        "GROUP BY county_state_label\r\n",
        "ORDER BY total_emissions DESC;"
      ],
      "catalog": "us_emissions_catalog_8_5",
      "schema": "raw"
    },
    {
      "name": "0fcf977a",
      "displayName": "graph_2_emission",
      "queryLines": [
        "SELECT\r\n",
        "    county_name,\r\n",
        "    state_abbr,\r\n",
        "    population,\r\n",
        "    ghg_emissions_mtco2e,\r\n",
        "    climate_zone,\r\n",
        "    employment,\r\n",
        "    ROUND(ghg_emissions_mtco2e / population * 1000, 4) AS emissions_per_1000_capita\r\n",
        "FROM us_emissions_catalog_8_5.raw.emission_df2\r\n",
        "WHERE population > 0 AND ghg_emissions_mtco2e > 0\r\n",
        "ORDER BY population DESC;"
      ]
    },
    {
      "name": "f2078220",
      "displayName": "Total_emisson_per_person_st",
      "queryLines": [
        "WITH state_emissions AS (\r\n",
        "  SELECT \r\n",
        "    state_abbr,\r\n",
        "    SUM(ghg_emissions_mtco2e) AS total_st_emissions,\r\n",
        "    SUM(population) AS total_st_population\r\n",
        "  FROM emission_df2\r\n",
        "  GROUP BY state_abbr\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  total_st_emissions,\r\n",
        "  total_st_population,\r\n",
        "  ROUND(total_st_emissions / (SELECT SUM(total_st_emissions) FROM state_emissions) * 100, 3) AS pct_emission_state,\r\n",
        "  ROUND(total_st_emissions / total_st_population, 4) AS emission_per_person_state\r\n",
        "FROM state_emissions\r\n",
        "ORDER BY emission_per_person_state DESC\r\n",
        "LIMIT 15;"
      ],
      "catalog": "us_emissions_catalog_8_5",
      "schema": "raw"
    }
  ],
